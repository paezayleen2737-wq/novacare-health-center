# Puerto en el que corre el servidor
PORT=3000

# Entorno de ejecución
NODE_ENV=development

# Ruta del archivo de base de datos SQLite
DB_PATH=./database/novacare.db

# Secreto usado para firmar los JWT (cambiar en producción)
JWT_SECRET=cambia_este_valor_por_uno_seguro_en_produccion
JWT_EXPIRES_IN=8h

# Credenciales del usuario administrador que se crea con el seed
ADMIN_NAME=Administrador NovaCare
ADMIN_EMAIL=admin@novacare.com
ADMIN_PASSWORD=NovaCare2026!
